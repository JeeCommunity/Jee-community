# OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
# Users configure this via the Settings menu in the AI Studio UI.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudinary Configuration for Image Uploads
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# CUSTOM_GEMINI_API_KEY: Required for native Gemini AI API calls.
CUSTOM_GEMINI_API_KEY="YOUR_CUSTOM_GEMINI_API_KEY"

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# FIREBASE_SERVICE_ACCOUNT: Required to send push notifications via Firebase Admin SDK.
# Go to Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Copy the entire JSON content and paste it here in one line (or as a string).
FIREBASE_SERVICE_ACCOUNT=

# API variables for NOVA Agent connection
WEBSITE_API_KEY=
WEBSITE_API_URL=

# Google Drive API
GOOGLE_DRIVE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GMAIL_USER=
GMAIL_APP_PASSWORD=

