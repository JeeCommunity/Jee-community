rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /admin_statuses/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'aistoryimage1999@gmail.com' || 
        request.auth.token.email != null
      );
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
