rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == 'aistoryimage1999@gmail.com');
    }
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.token.email == 'aistoryimage1999@gmail.com');
    }
    match /likes/{likeId} {
      allow read, write: if request.auth != null;
    }
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId || 
        request.auth.uid == get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorId ||
        request.auth.token.email == 'aistoryimage1999@gmail.com'
      );
    }

    match /study_sessions/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'aistoryimage1999@gmail.com');
    }

    match /notes_hub/{noteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uploadedBy.uid || request.auth.token.email == 'aistoryimage1999@gmail.com');
    }
    
    match /study_notes/{noteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.token.email == 'aistoryimage1999@gmail.com');
    }
    
    match /note_upvotes/{upvoteId} {
      allow read, write: if request.auth != null;
    }
    match /feedback/{feedbackId} {
      allow read: if request.auth != null && (request.auth.token.email == 'aistoryimage1999@gmail.com' || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.token.email == 'aistoryimage1999@gmail.com';
      allow delete: if request.auth != null && request.auth.token.email == 'aistoryimage1999@gmail.com';
    }
    match /banned_emails/{email} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'aistoryimage1999@gmail.com';
    }
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
    }

    match /beats/{beatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email == 'aistoryimage1999@gmail.com');
    }
    
    match /study_groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
      match /typing/{uid} {
        allow read, write: if request.auth != null;
      }
    }

    match /metadata/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /admin_statuses/{statusId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (
        request.auth.token.email == 'aistoryimage1999@gmail.com' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      match /views/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /status_replies/{replyId} {
      allow read: if request.auth != null && (
        request.auth.token.email == 'aistoryimage1999@gmail.com' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.uid == resource.data.senderId
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.token.email == 'aistoryimage1999@gmail.com' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.uid == resource.data.senderId
      );
    }
  
    match /personal_notes/{noteId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /error_notes/{errorId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
